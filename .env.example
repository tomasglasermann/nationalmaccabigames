# ---- Admin login (single admin) ----
ADMIN_EMAIL=tomasg@marjcc.org
ADMIN_PASSWORD=change-me-to-a-long-password
# Random long string used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-string

# ---- Supabase (database) ----
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVICE ROLE key — server-only, never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Resend (email) — added in a later phase ----
RESEND_API_KEY=
MAIL_FROM=NMB Maccabi <tomasg@marjcc.org>

# ---- RedPodium webhook (donations) — added in a later phase ----
# A secret you invent; set the same value in RedPodium's webhook config.
REDPODIUM_WEBHOOK_SECRET=
